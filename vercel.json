{
  "version": 2,
  "builds": [
    {
      "src": "ml/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "website/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/scan/(.*)",
      "dest": "ml/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "website/$1"
    }
  ]
}